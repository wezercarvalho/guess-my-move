{
    "name": "guess-my-move",
    "private": true,
    "license": "MIT",
    "description": "Guess My Move: monorepo da PoC (web React+Vite, servidor NestJS, pacote core de contratos) e ferramentas de governança do repositório (SDD, docs e gates).",
    "packageManager": "yarn@4.18.1",
    "engines": {
        "node": ">=26.12.1 <27"
    },
    "workspaces": [
        "apps/web",
        "packages/core",
        "packages/marbles",
        "packages/swing"
    ],
    "scripts": {
        "typecheck": "yarn workspaces foreach --all --topological run typecheck",
        "lint": "oxlint",
        "test": "yarn workspaces foreach --all --topological run test",
        "build": "yarn workspaces foreach --all --topological run build",
        "check:static": "yarn typecheck && yarn lint",
        "check:all": "yarn check:static && yarn test && yarn build",
        "dev:web": "yarn workspace @guess-my-move/web dev",
        "sdd:check": "node scripts/sdd/check-specs.mjs --root .",
        "test:sdd": "node --test test/sdd/check-specs.node-test.mjs test/sdd/check-gate.node-test.mjs",
        "docs:format:check": "prettier --check .prettierrc AGENTS.md CLAUDE.md README.md \"docs/**/*.md\" \"specs/**/*.md\"",
        "docs:format:fix": "prettier --write .prettierrc AGENTS.md CLAUDE.md README.md \"docs/**/*.md\" \"specs/**/*.md\"",
        "test:gates": "node --test test/security/dependency-audit.node-test.mjs test/security/dependency-audit-exceptions.node-test.mjs test/security/dependency-audit-workflows.node-test.mjs test/gates/hook-and-gate.node-test.mjs",
        "security:dependencies": "node scripts/audit-dependencies.mjs"
    },
    "devDependencies": {
        "oxlint": "1.89.0",
        "oxlint-tsgolint": "7.0.2004",
        "prettier": "3.9.10",
        "typescript": "7.0.2",
        "yaml": "2.9.0"
    }
}
