{
    "name": "@guess-my-move/server",
    "version": "0.0.0",
    "private": true,
    "license": "MIT",
    "type": "module",
    "scripts": {
        "dev": "node scripts/dev.mjs",
        "test:cards": "vitest run test/card-rounds.test.ts test/card-rounds.e2e.test.ts",
        "test:compiled": "node scripts/smoke-compiled.mjs",
        "start": "node dist/main.js",
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "contracts:export": "node scripts/contracts.mjs",
        "contracts:check": "node scripts/contracts.mjs --check",
        "load:swing": "node scripts/load-swing.mjs"
    },
    "dependencies": {
        "@guess-my-move/core": "0.0.0",
        "@guess-my-move/marbles": "0.0.0",
        "@guess-my-move/swing": "0.0.0",
        "@nestjs/common": "12.3.3",
        "@nestjs/core": "12.3.3",
        "@nestjs/observe": "0.3.24",
        "@nestjs/platform-node": "12.3.3",
        "@nestjs/platform-socket.io": "12.3.3",
        "@nestjs/websockets": "12.3.3",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "socket.io": "4.8.4",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@nestjs/testing": "12.3.3",
        "@swc/core": "1.16.18",
        "@types/node": "26.6.5",
        "socket.io-client": "4.8.4",
        "typescript": "7.0.2",
        "unplugin-swc": "2.0.0",
        "vite": "8.3.4",
        "vitest": "5.0.5"
    }
}
