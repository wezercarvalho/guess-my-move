# O processo não lê .env automaticamente: exporte estas variáveis no ambiente.
PORT=3000
MAX_ROOMS=100
SERVER_TICK_MS=33
ROOM_WAITING_TIMEOUT_MS=300000
ROOM_IDLE_TIMEOUT_MS=900000
ROOM_FINISHED_TIMEOUT_MS=300000
MAX_CONNECTIONS=200
MAX_CONNECTIONS_PER_IP=10
ROOM_ATTEMPTS_PER_MINUTE=20
MAX_TRACKED_ADDRESSES=10000
# Origens exatas, separadas por vírgula. Ajuste para o domínio HTTPS ao hospedar.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOW_ORIGINLESS_CLIENTS=false
# Opcional: IPs explícitos dos proxies intermediários. Omitido = não confiar em XFF.
# TRUSTED_PROXY_IPS=127.0.0.1
# Contratos JSON HTTP no ambiente de desenvolvimento:
ENABLE_API_DOCS=false
# Sem token, o endpoint de métricas fica desativado. Gerar valor aleatório >=32 caracteres.
# METRICS_TOKEN=
# SDK externo: não ativado por NODE_ENV; exige opt-in e credenciais próprias.
OBSERVE_ENABLED=false
OBSERVE_SAMPLE_RATE=0.1
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
# OBSERVE_ENDPOINT=https://observe-api.nestjs.com
