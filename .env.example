# Configuração do servidor Guess My Move. Copie para `.env` e ajuste.
# NUNCA versione o `.env` nem coloque chaves reais aqui.

# Porta do servidor NestJS (o proxy /api do Vite aponta para ela).
PORT=3000

# Provedor de adivinhação: mock (padrão) ou codex.
GUESSER_PROVIDER=mock

# Limites de payload validados no cliente e no servidor.
MAX_FRAMES=6
MAX_FRAME_BYTES=262144
MAX_TOTAL_BYTES=1572864

# Timeout, rate limit e teto de custo das rotas que chamam o provedor.
REQUEST_TIMEOUT_MS=15000
RATE_LIMIT_PER_MINUTE=20
COST_CEILING_ATTEMPTS_PER_HOUR=60

# Configuração do adaptador codex (usada só quando GUESSER_PROVIDER=codex).
# Deixe em branco no modo mock. A chave/credencial do provedor nunca vai ao
# navegador, ao bundle, aos logs nem ao repositório.
CODEX_MODEL=
CODEX_REASONING_EFFORT=
CODEX_BIN=
