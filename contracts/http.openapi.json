    "/api/cards/rounds": {
      "post": {
        "operationId": "startCardRound",
        "summary": "Iniciar rodada competitiva efêmera",
        "description": "Experimental, sem ranking. Exige Origin permitido. Somente ângulo escalar/null; não enviar mídia, landmarks, timestamps ou pontuação. Limite de corpo 2048 B; comandos de observação espaçados em pelo menos 50 ms; acesso válido por 40 s nas cartas atuais, com varredura de descarte a cada segundo.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "cardId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "locale": {
                    "type": "string",
                    "enum": [
                      "pt-BR",
                      "en-US"
                    ]
                  }
                },
                "required": [
                  "cardId",
                  "locale"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Resposta válida",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "roundId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "token": {
                      "type": "string",
                      "minLength": 32,
                      "maxLength": 128
                    },
                    "round": {
                      "type": "object",
                      "properties": {
                        "card": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string"
                            },
                            "locale": {
                              "type": "string"
                            },
                            "public": {
                              "type": "object",
                              "properties": {
                                "word": {
                                  "type": "string"
                                },
                                "hint": {
                                  "type": "string"
                                },
                                "suggestion": {
                                  "type": "string"
                                },
                                "difficulty": {
                                  "type": "string"
                                },
                                "category": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "word",
                                "hint",
                                "suggestion"
                              ],
                              "additionalProperties": false
                            }
                          },
                          "required": [
                            "id",
                            "locale",
                            "public"
                          ],
                          "additionalProperties": false
                        },
                        "state": {
                          "type": "string",
                          "enum": [
                            "detecting",
                            "recognized",
                            "timed_out",
                            "user_cancelled"
                          ]
                        },
                        "elapsedMs": {
                          "type": "number",
                          "minimum": 0
                        },
                        "maxDurationMs": {
                          "type": "number",
                          "minimum": 1
                        },
                        "score": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "card",
                        "state",
                        "elapsedMs",
                        "maxDurationMs",
                        "score"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "roundId",
                    "token",
                    "round"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Comando recusado sem dados privados"
          },
          "401": {
            "description": "Comando recusado sem dados privados"
          },
          "403": {
            "description": "Comando recusado sem dados privados"
          },
          "404": {
            "description": "Comando recusado sem dados privados"
          },
          "409": {
            "description": "Comando recusado sem dados privados"
          },
          "413": {
            "description": "Comando recusado sem dados privados"
          },
          "415": {
            "description": "Comando recusado sem dados privados"
          },
          "429": {
            "description": "Comando recusado sem dados privados"
          },
          "503": {
            "description": "Comando recusado sem dados privados"
          }
        }
      }
    },
