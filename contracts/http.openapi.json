    "/api/capabilities": {
      "get": {
        "operationId": "getCapabilities",
        "summary": "Capacidades públicas e transporte do multiplayer",
        "security": [],
        "responses": {
          "200": {
            "description": "Resposta válida",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "protocolVersion": {
                      "type": "number",
                      "const": 1
                    },
                    "transport": {
                      "type": "string",
                      "const": "socket.io"
                    },
                    "socketIoMajor": {
                      "type": "number",
                      "const": 4
                    },
                    "path": {
                      "type": "string",
                      "const": "/socket.io"
                    },
                    "namespace": {
                      "type": "string",
                      "const": "/"
                    },
                    "modes": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "bete",
                          "triangle",
                          "hole"
                        ]
                      }
                    },
                    "reconnectGraceMs": {
                      "type": "number",
                      "const": 60000
                    },
                    "games": {
                      "type": "object",
                      "properties": {
                        "marbles": {
                          "type": "object",
                          "properties": {
                            "namespace": {
                              "type": "string",
                              "const": "/"
                            },
                            "contract": {
                              "type": "string",
                              "const": "/api/contracts/multiplayer"
                            }
                          },
                          "required": [
                            "namespace",
                            "contract"
                          ],
                          "additionalProperties": false
                        },
                        "swing": {
                          "type": "object",
                          "properties": {
                            "namespace": {
                              "type": "string",
                              "const": "/swing"
                            },
                            "contract": {
                              "type": "string",
                              "const": "/api/contracts/swing"
                            },
                            "maxPlayers": {
                              "type": "number",
                              "const": 2
                            },
                            "cooperative": {
                              "type": "boolean",
                              "const": true
                            },
                            "cityIds": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "enum": [
                                  "aurora",
                                  "midtown",
                                  "paulista",
                                  "santa-maria"
                                ]
                              }
                            }
                          },
                          "required": [
                            "namespace",
                            "contract",
                            "maxPlayers",
                            "cooperative",
                            "cityIds"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "marbles",
                        "swing"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "protocolVersion",
                    "transport",
                    "socketIoMajor",
                    "path",
                    "namespace",
                    "modes",
                    "reconnectGraceMs",
                    "games"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "500": {
            "description": "Erro HTTP sem dados privados",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "statusCode",
                    "message"
                  ]
                }
              }
            }
          }
        }
      }
    },
