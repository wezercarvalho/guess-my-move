                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "telemetryFailures": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "expiredRooms": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "maxTickDelayMs": {
                      "type": "number",
                      "minimum": 0
                    },
                    "activeConnections": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "activeTransports": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "activeRooms": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "operations": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "count": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "errors": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "totalMs": {
                            "type": "number",
                            "minimum": 0
                          },
                          "maxMs": {
                            "type": "number",
                            "minimum": 0
                          }
                        },
                        "required": [
