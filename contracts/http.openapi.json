    "/api/metrics": {
      "get": {
        "operationId": "getMetrics",
        "summary": "Métricas agregadas de operação; habilitado somente com METRICS_TOKEN",
        "security": [
          {
            "metricsToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Resposta válida",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "acceptedConnections": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "rejectedConnections": {
                      "type": "integer",
                      "minimum": 0,
